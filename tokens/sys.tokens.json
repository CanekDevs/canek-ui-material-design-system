{
  "name": "Canek UI · capa sys",
  "note": "Roles del sistema. Un valor entre llaves apunta a un token de la capa ref (tokens/base.tokens.json); el resto son valores derivados para el modo oscuro, que la marca no tiene. Los componentes solo usan esta capa o la comp.",
  "color": {
    "primary": {
      "light": "{color-action}",
      "dark": "{color-indigo-300}",
      "usage": "Botones principales, foco, controles seleccionados, enlaces."
    },
    "primary-hover": {
      "light": "{color-action-hover}",
      "dark": "#a8b5ff",
      "usage": "Hover de elementos primary rellenos."
    },
    "on-primary": {
      "light": "{color-white}",
      "dark": "#121212",
      "usage": "Texto e íconos sobre primary."
    },
    "primary-container": {
      "light": "rgba(61,90,254,0.12)",
      "dark": "rgba(140,158,255,0.16)",
      "usage": "Fondo suave de elementos primary (chips seleccionados, filas activas)."
    },
    "on-primary-container": {
      "light": "{color-indigo-600}",
      "dark": "#c5cdff",
      "usage": "Texto sobre primary-container."
    },
    "brand": {
      "light": "{color-brand-primary}",
      "dark": "{color-brand-350}",
      "usage": "Identidad de marca: navbar, encabezados de marca, estado por defecto."
    },
    "brand-dark": {
      "light": "{color-brand-primary-dark}",
      "dark": "{color-brand-500}",
      "usage": "Hover y variantes oscuras de brand."
    },
    "brand-light": {
      "light": "{color-brand-primary-light}",
      "dark": "{color-brand-100}",
      "usage": "Acentos claros de marca."
    },
    "on-brand": { "light": "{color-white}", "dark": "#121212", "usage": "Texto sobre brand." },
    "brand-container": {
      "light": "{tint-brand-700-12}",
      "dark": "rgba(132,189,237,0.16)",
      "usage": "Fondos suaves de marca."
    },
    "background": {
      "light": "{color-app-bg}",
      "dark": "#121212",
      "usage": "Fondo de la aplicación."
    },
    "surface": {
      "light": "{color-surface}",
      "dark": "#1e1e1e",
      "usage": "Paper, tarjetas, diálogos, menús."
    },
    "surface-container": {
      "light": "{color-surface-soft}",
      "dark": "#2a2a2a",
      "usage": "Superficies anidadas, encabezados de tabla, inputs rellenos."
    },
    "surface-container-high": {
      "light": "{color-neutral-100}",
      "dark": "#333333",
      "usage": "Superficie con más énfasis (hover de filas, tooltips claros)."
    },
    "on-surface": {
      "light": "{color-text-primary}",
      "dark": "#e8e8e8",
      "usage": "Texto principal."
    },
    "on-surface-variant": {
      "light": "{color-text-secondary}",
      "dark": "#b3b3b3",
      "usage": "Texto secundario, labels, íconos."
    },
    "text-title": {
      "light": "{color-text-title}",
      "dark": "#f2f2f2",
      "usage": "Títulos (regla de marca: negro #2E2E2E)."
    },
    "text-muted": {
      "light": "{color-text-muted}",
      "dark": "#a6a6a6",
      "usage": "Texto de apoyo y placeholders."
    },
    "outline": {
      "light": "{color-border-default}",
      "dark": "#3a3a3a",
      "usage": "Bordes y divisores."
    },
    "outline-strong": {
      "light": "{color-input-border}",
      "dark": "#5c5c5c",
      "usage": "Borde de inputs outlined."
    },
    "success": {
      "light": "{color-status-success}",
      "dark": "{color-green-300}",
      "usage": "Íconos, bordes e indicadores de éxito."
    },
    "success-fill": {
      "light": "{color-green-800}",
      "dark": "{color-green-300}",
      "usage": "Relleno con texto encima (botón Success, chip relleno). Más oscuro que success para cumplir AA."
    },
    "on-success": {
      "light": "{color-white}",
      "dark": "#121212",
      "usage": "Texto sobre success-fill."
    },
    "success-text": {
      "light": "{color-green-800}",
      "dark": "{color-green-200}",
      "usage": "Texto de éxito sobre surface."
    },
    "success-container": {
      "light": "{tint-status-success-12}",
      "dark": "rgba(129,199,132,0.16)",
